@Host =  http://localhost
@Port = 3000

@Server = {{Host}}:{{Port}}

### Get all tasks
GET {{Server}}/api/tasks
Content-Type: application/json

### Get a task by id
GET {{Server}}/api/tasks/10
Content-Type: application/json

### Create a new task
POST {{Server}}/api/tasks
Content-Type: application/json

{
  "title": "New Task",
  "description": "This is a new task.",
  "deadline": "2026-12-01",
  "completed": true
}

### delete a task by id
DELETE {{Server}}/api/tasks/3
Content-Type: application/json

### delete all tasks
DELETE {{Server}}/api/tasks
Content-Type: application/json

### Update a task by id
PATCH  {{Server}}/api/tasks/10
Content-Type: application/json

{
  "title": "Updated Task",
  "description": "This task has been updated.",
  "deadline": "2026-12-15",
  "completed": true
}